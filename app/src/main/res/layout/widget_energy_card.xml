<?xml version="1.0" encoding="utf-8"?>
<!-- 电费官方入口与校园卡缓存；预览数据仅用于展示布局。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="@dimen/widget_pad">

    <!-- 右上角：数据更新到什么时候（对应课表那个「第 N 周」的位置） -->
    <TextView
        android:id="@+id/update"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/widget_preview_balance_update"
        android:textColor="@color/widget_text_hint"
        android:textSize="@dimen/widget_week" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- ══════ 左半：宿舍电量（点它去电费页） ══════ -->
        <LinearLayout
            android:id="@+id/zone_energy"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/left_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_preview_balance_header"
                android:textColor="@color/widget_text"
                android:textSize="@dimen/widget_side_title"
                android:textStyle="bold" />

            <!-- 块 1：照明 -->
            <LinearLayout
                android:id="@+id/block_l1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/bar_1"
                        android:layout_width="@dimen/widget_bar_w"
                        android:layout_height="@dimen/widget_bar_h_sm"
                        android:background="@drawable/widget_bar" />

                    <TextView
                        android:id="@+id/label_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/widget_electricity_query"
                        android:textColor="@color/widget_text"
                        android:textSize="@dimen/widget_block_label"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/widget_gap_xs"
                    android:baselineAligned="false"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/value_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/widget_preview_balance_light"
                        android:textColor="@color/widget_text"
                        android:textSize="@dimen/widget_block_value"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/unit_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:includeFontPadding="false"
                        android:text=""
                        android:textColor="@color/widget_text_dim"
                        android:textSize="@dimen/widget_block_unit" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/hint_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/widget_preview_days_left"
                        android:textColor="@color/widget_text_hint"
                        android:textSize="@dimen/widget_block_hint" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/left_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:alpha="0.2"
                android:background="@color/widget_divider" />

            <!-- 块 2：空调 -->
            <LinearLayout
                android:id="@+id/block_l2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/bar_2"
                        android:layout_width="@dimen/widget_bar_w"
                        android:layout_height="@dimen/widget_bar_h_sm"
                        android:background="@drawable/widget_bar" />

                    <TextView
                        android:id="@+id/label_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/widget_electricity_web"
                        android:textColor="@color/widget_text"
                        android:textSize="@dimen/widget_block_label"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/widget_gap_xs"
                    android:baselineAligned="false"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/value_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/widget_preview_balance_ac"
                        android:textColor="@color/widget_text"
                        android:textSize="@dimen/widget_block_value"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/unit_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:includeFontPadding="false"
                        android:text=""
                        android:textColor="@color/widget_text_dim"
                        android:textSize="@dimen/widget_block_unit" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/hint_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/widget_preview_days_left_ac"
                        android:textColor="@color/widget_text_hint"
                        android:textSize="@dimen/widget_block_hint" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 两半之间的竖分隔线 -->
        <TextView
            android:id="@+id/mid_divider"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/widget_gap"
            android:layout_marginEnd="@dimen/widget_gap"
            android:alpha="0.2"
            android:background="@color/widget_divider" />

        <!-- ══════ 右半：校园卡（点它去校园卡页） ══════ -->
        <LinearLayout
            android:id="@+id/zone_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/right_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_balance_card"
                android:textColor="@color/widget_text"
                android:textSize="@dimen/widget_side_title"
                android:textStyle="bold" />

            <!-- 块 1：余额 -->
            <LinearLayout
                android:id="@+id/block_r1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/bar_3"
                        android:layout_width="@dimen/widget_bar_w"
                        android:layout_height="@dimen/widget_bar_h_sm"
                        android:background="@drawable/widget_bar" />

                    <TextView
                        android:id="@+id/label_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/widget_balance_balance"
                        android:textColor="@color/widget_text"
                        android:textSize="@dimen/widget_block_label"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/widget_gap_xs"
                    android:baselineAligned="false"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/value_3"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="16sp"
                        android:autoSizeMaxTextSize="28sp"
                        android:autoSizeStepGranularity="1sp"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/widget_preview_balance_card"
                        android:textColor="@color/widget_text"
                        android:textSize="@dimen/widget_block_value"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/unit_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:includeFontPadding="false"
                        android:text="@string/widget_unit_yuan"
                        android:textColor="@color/widget_text_dim"
                        android:textSize="@dimen/widget_block_unit" />
                </LinearLayout>

                <TextView
                    android:id="@+id/hint_3"
                    android:layout_width="match_parent"
                    android:layout_marginTop="2dp"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_preview_balance_today"
                    android:textColor="@color/widget_text_hint"
                    android:textSize="@dimen/widget_block_hint" />
            </LinearLayout>

            <TextView
                android:id="@+id/right_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:alpha="0.2"
                android:background="@color/widget_divider" />

            <!-- 块 2：本周 -->
            <LinearLayout
                android:id="@+id/block_r2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/bar_4"
                        android:layout_width="@dimen/widget_bar_w"
                        android:layout_height="@dimen/widget_bar_h_sm"
                        android:background="@drawable/widget_bar" />

                    <TextView
                        android:id="@+id/label_4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/widget_balance_week"
                        android:textColor="@color/widget_text"
                        android:textSize="@dimen/widget_block_label"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/widget_gap_xs"
                    android:baselineAligned="false"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/value_4"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="16sp"
                        android:autoSizeMaxTextSize="28sp"
                        android:autoSizeStepGranularity="1sp"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/widget_preview_balance_week"
                        android:textColor="@color/widget_text"
                        android:textSize="@dimen/widget_block_value"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/unit_4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:includeFontPadding="false"
                        android:text="@string/widget_unit_yuan"
                        android:textColor="@color/widget_text_dim"
                        android:textSize="@dimen/widget_block_unit" />
                </LinearLayout>

                <TextView
                    android:id="@+id/hint_4"
                    android:layout_width="match_parent"
                    android:layout_marginTop="2dp"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_preview_balance_week_count"
                    android:textColor="@color/widget_text_hint"
                    android:textSize="@dimen/widget_block_hint" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
